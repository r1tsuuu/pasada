# Every variable used by Pasada. No real values here, ever.
# Server variables go in apps/server/.env ; web variables go in apps/web/.env

# ---------- apps/server/.env ----------
PORT=8080
WEB_ORIGIN=http://localhost:5173
PUBLIC_WEB_URL=http://localhost:5173

# Stellar Testnet keys (npm run keys fills these)
PROGRAM_OWNER_SECRET=
AGENT_J1_SECRET=
AGENT_J2_SECRET=
AGENT_J3_SECRET=
STATION_S1_SECRET=
STATION_S2_SECRET=
STATION_S3_PUBLIC=

# Velo (velo-build.dev dashboard)
VELO_API_KEY=
VELO_WEBHOOK_SECRET=
VELO_BASE_URL=

# Optional overrides
NOIR_RPC_URL=
ADMIN_TOKEN=
DATA_DIR=./data

# ---------- apps/web/.env ----------
VITE_API_URL=http://localhost:8080
